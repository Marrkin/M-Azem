{
  "name": "mtech-patrimonio-control",
  "version": "1.0.0",
  "description": "Simple CRUD for asset management using Node, SQLite, and Vue",
  "main": "src/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:server": "cross-env NODE_ENV=development nodemon --no-deprecation --signal SIGTERM src/server.js",
    "dev:vite": "vite --host",
    "build": "vite build",
    "clear-assets": "node clear-assets.js",
    "import-json-assets": "node import-json-assets.js"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^5.1.7",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.1"
  }
}

